# Copy to ".env" and fill in. NEVER commit the real .env.
# Secrets stay ONLY here (local) and in Render/Vercel env vars — NEVER in git, NEVER in frontend.
GROQ_API_KEY=
DEEPGRAM_KEY=
ELEVENLABS_KEY=
ELEVEN_VOICE_A=EXAVITQu4vr4xnSDxMaL
ELEVEN_VOICE_B=onwK4e9ZLuTAKqWW03F9

# Supabase project "samvaad" (ap-south-1 / Mumbai) — already provisioned
SUPABASE_URL=https://bwcszkbtvbvwzioycxxp.supabase.co
# Secret — copy from dashboard: Project Settings → API → service_role key. NEVER expose in the browser.
SUPABASE_SERVICE_KEY=

# WhatsApp daily check-ins (retention) — NOT wired yet. /api/optin only captures + stores the
# opt-in for now. Pick ONE provider when ready, fill its vars, then implement the send in the
# /api/optin TODO + add a daily scheduler that reads the nudge_subscriptions table.
# Meta WhatsApp Cloud API (example):
# WHATSAPP_TOKEN=<secret>
# WHATSAPP_PHONE_NUMBER_ID=<secret>
# WHATSAPP_TEMPLATE_DAILY=daily_checkin
# (or Gupshup / Interakt / Twilio WhatsApp equivalents)

# Admin allowlist — comma-separated Supabase auth user ids granted access to /api/admin/* endpoints.
ADMIN_USER_IDS=

# Signs the short-lived guest tokens that let un-signed-in testers use the app without leaving
# /api/analyze, /api/transcribe and /api/tts open to the whole internet. Any long random string.
GUEST_SECRET=

# Lock CORS to your frontend origin in production (e.g. https://samvaad.vercel.app)
ALLOWED_ORIGIN=*
PORT=8787

# Analysis model — OPTIONAL, and normally left blank. The backend asks Groq which models it
# actually serves and takes the best match (see MODEL_PREFERENCE in server.js), so when Groq
# retires one, the next request continues on its replacement instead of failing. Fill this in only
# to pin one specific model.
GROQ_MODEL=
# Groq tokens-per-minute for that model on your plan. Free = 8000. This single number sets how
# long a conversation the product can accept; raise it after upgrading the Groq plan.
GROQ_TPM=8000
